# Copy to .env next to docker-compose.yml, fill in and keep it private
# (chmod 600 .env). Never commit .env.

# Image version to run: the tag you built and loaded (see README).
SCHEDULING_IMAGE=makerslink_scheduling:v1.0.0

# Django secret key, a long random string, for example from
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET=
# Password for the scheduling@makerslink.se mail account (invites, password reset).
SCHEDULING_PASS=

# Optional, defaults shown.
#SCHEDULING_CONTAINER=scheduling
#SCHEDULING_PORT=8000
#SCHEDULING_DB_DIR=./data/db
#SCHEDULING_PKS_DIR=./data/pks
